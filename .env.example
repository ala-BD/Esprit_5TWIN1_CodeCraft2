APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Gemini — analyse textile et génération d’images
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TIMEOUT=45

# Génération locale gratuite des photos de dons via ComfyUI
DONATION_IMAGE_PROVIDER=comfyui
COMFYUI_URL=http://127.0.0.1:8188
# Nom du checkpoint image-to-image placé dans ComfyUI/models/checkpoints
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly-fp16.safetensors
COMFYUI_STEPS=20
COMFYUI_CFG=6.5
# Valeur intermédiaire pour extraire le vêtement tout en préservant ses détails (entre 0.1 et 0.9).
COMFYUI_DENOISE=0.5
COMFYUI_TIMEOUT=180

# Assistant vocal — clé gratuite sur https://console.groq.com/keys
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=https://api.groq.com/openai/v1
ASSISTANT_MODEL=openai/gpt-oss-120b
ASSISTANT_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
ASSISTANT_VOICE_MODEL=canopylabs/orpheus-v1-english
ASSISTANT_VOICE=hannah

# -------------------------------------------------------
# Stripe — each team member sets their own test keys locally
# https://dashboard.stripe.com/test/apikeys
# -------------------------------------------------------
STRIPE_KEY=pk_test_...
STRIPE_SECRET=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=eur

# -------------------------------------------------------
# IA pour l'Atelier (Gemini / LLM) — Clé API locale
# -------------------------------------------------------
AI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
AI_TIMEOUT=10

# M5 Logistique — géocodage gratuit (OpenStreetMap) et dépôt de départ des tournées
GEOCODAGE_ACTIF=true
LOGISTIQUE_DEPOT_NOM="Entrepôt RETISS — Charguia"
LOGISTIQUE_DEPOT_LAT=36.8380
LOGISTIQUE_DEPOT_LNG=10.2070
